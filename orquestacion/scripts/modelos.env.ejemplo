# Copia este archivo a .orquestacion/modelos.env (está fuera de git) y pon los nombres
# EXACTOS que acepta `agy --model <nombre>` (los lista `agy models`).
# Para usar Claude Code en vez de Antigravity: "claude:<modelo>[:<esfuerzo>]",
# p. ej. "claude:claude-opus-5-5:low".
# Los valores de abajo son un ejemplo: cámbialos según la cuota que tengas.

# Planificador: parte cada tarea en subtareas pequeñas (el orquestador lo revisa)
ORQ_MODELO_PLANIFICADOR="gemini-4-argon-medium"

# Revisor: primera revisión de cada subtarea entregada (solo lectura)
ORQ_MODELO_REVISOR="gemini-4-argon-low"

# Revisor ligero: revisiones de subtareas pequeñas (si falta, usa el revisor)
ORQ_MODELO_REVISOR_LIGERO="claude-sonnet-5-5-low"

# Tareas acotadas: cada subtarea pequeña del plan de la tarea
ORQ_MODELO_ACOTADO="gemini-3.8-flash-low"

# Tareas complejas: solo correcciones tras dos rondas fallidas
ORQ_MODELO_COMPLEJO="gemini-4-argon-medium"
